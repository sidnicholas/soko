# --- Core ---
NODE_ENV=development
LOG_LEVEL=info
# --- Postgres / Supabase ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/opportunity_os
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# --- Redis ---
REDIS_URL=redis://localhost:6379
# --- Temporal ---
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=opportunity-os
# --- LLM Gateway ---
LLM_DEFAULT_PROVIDER=echo
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
EMBEDDING_PROVIDER=echo
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=512
# --- Settlement ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DEFAULT_STABLECOIN_NETWORK=base-sepolia
CHAIN_RPC_URL=
# --- Notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
EMAIL_FROM=
SMTP_URL=
# --- Security ---
APPROVAL_TOKEN_SECRET=change-me
AUDIT_ANCHOR_ENABLED=false
# --- Decision packet defaults (ADR-016) ---
APPROVAL_TIMEOUT_MINUTES=60
MISSION_REFRESH_INTERVAL_MINUTES=15
SUPPLY_STALE_MINUTES=1440
