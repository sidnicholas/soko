# --- Core ---
NODE_ENV=development
LOG_LEVEL=info
# --- Postgres / Supabase ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/opportunity_os
# Live-DB tests use this, never DATABASE_URL; must be a local host. `pnpm test:db` defaults it.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:54329/opportunity_os_test
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Legacy HS256 projects only; leave blank when the project uses JWT signing keys (JWKS).
SUPABASE_JWT_SECRET=
# --- Auth (§22) ---
# Local dev only: trust x-user-id / x-user-role headers. Refused in production.
AUTH_DEV_HEADERS=true
# Comma-separated emails that become `admin` on first sign-in.
AUTH_ADMIN_EMAILS=
# Comma-separated browser origins allowed to call the API (CORS).
WEB_ORIGINS=http://localhost:3000
# Web app: set both to turn on Supabase sign-in (blank = dev headers).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# --- Redis ---
REDIS_URL=redis://localhost:6379
# --- Temporal ---
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=opportunity-os
# --- LLM Gateway ---
LLM_DEFAULT_PROVIDER=echo
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Defaults: claude-haiku-4-5 (extraction), claude-sonnet-5-5 (reasoning)
ANTHROPIC_FAST_MODEL=
ANTHROPIC_REASONING_MODEL=
# Cheaper open-weight models through an OpenAI-compatible host (Together, Groq,
# DeepSeek, OpenRouter, ...). Set a tier to "compat" (default "anthropic"); it
# falls back to Claude when ANTHROPIC_API_KEY is set. A compat tier needs the URL,
# key, model and its price ("input,output" USD per million tokens).
# LLM_FAST_PROVIDER=compat
# LLM_REASONING_PROVIDER=compat
LLM_COMPAT_BASE_URL=
LLM_COMPAT_API_KEY=
LLM_COMPAT_FAST_MODEL=
LLM_COMPAT_FAST_PRICE=
LLM_COMPAT_REASONING_MODEL=
LLM_COMPAT_REASONING_PRICE=
# JSON merged into every compat request, e.g. for OpenRouter: {"provider":{"require_parameters":true},"usage":{"include":true}}
LLM_COMPAT_EXTRA_BODY=
# You.com: one key for sweeps (INTEL_SEARCH_PROVIDER=youcom) and the assistant.
YDC_API_KEY=
# YOUCOM_CHAT_MODEL=kimi-k3
# YOUCOM_CHAT_PRICE=2.85,14.25
# YOUCOM_SEARCH_FEE_USD=0.005
# Opportunity assistant (the "Ask AI about this deal" chat). Each model shows up
# when its key is set: Claude uses ANTHROPIC_API_KEY + ANTHROPIC_REASONING_MODEL,
# OpenAI uses OPENAI_API_KEY. Prices are "input,output" USD per million tokens.
PERPLEXITY_API_KEY=
# PERPLEXITY_MODEL=sonar-pro
# PERPLEXITY_PRICE=3,15
# PERPLEXITY_REQUEST_FEE_USD=0.006
# OPENAI_CHAT_MODEL=gpt-5
# OPENAI_CHAT_PRICE=1.25,10
# Most the assistant may spend per UTC day, across every conversation (default 5)
# CHAT_DAILY_USD=5
VOYAGE_API_KEY=
EMBEDDING_PROVIDER=echo
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=512
# Cross-entity graph arbitrage deals: auto (default) = on only with a real EMBEDDING_PROVIDER; on; off
# GRAPH_ARBITRAGE_DEALS=
# --- Settlement ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DEFAULT_STABLECOIN_NETWORK=base-sepolia
CHAIN_RPC_URL=
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_ID=
# --- Notifications ---
# --- Pipedrive CRM (ADR-040) ---
# Company subdomain (acme for acme.pipedrive.com) and API token; pipeline/stage optional
PIPEDRIVE_COMPANY_DOMAIN=
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_PIPELINE_ID=
PIPEDRIVE_STAGE_ID=
# Basic auth Pipedrive sends on webhook deliveries (chosen here, registered from Settings)
PIPEDRIVE_WEBHOOK_USER=
PIPEDRIVE_WEBHOOK_PASSWORD=
# --- Apify actors (ADR-042) ---
# Token: worker-connectors and api. Webhook secret: any long random string, same on both.
APIFY_API_TOKEN=
APIFY_WEBHOOK_SECRET=
# Daily ceiling across every Apify source (USD)
APIFY_DAILY_BUDGET_USD=
# Good-deal filter (worker-connectors, needs the eBay credentials): share under market to raise a lead (default 0.3),
# listings checked and leads raised per sweep (defaults 100 and 10)
DEAL_MIN_DISCOUNT=
DEAL_CHECKS_PER_RUN=
DEAL_LEADS_PER_RUN=
# Buyer requests from actor sources (Alibaba RFQs, Craigslist WANTED) raised as demand leads per sweep (default 25)
DEMAND_LEADS_PER_RUN=
# --- Email outreach (ADR-045): api and worker-lifecycle ---
# One real mailbox (Hostinger defaults below). Sending stays off until address, password,
# postal address (CAN-SPAM) and PUBLIC_API_BASE_URL (unsubscribe link) are all set.
OUTREACH_EMAIL_ADDRESS=
OUTREACH_EMAIL_PASSWORD=
OUTREACH_FROM_NAME=
OUTREACH_POSTAL_ADDRESS=
OUTREACH_SMTP_HOST=
OUTREACH_SMTP_PORT=
OUTREACH_IMAP_HOST=
OUTREACH_IMAP_PORT=
# Sends per rolling 24 h (default 20; raise slowly), hours between messages to one contact without a reply (default 72)
OUTREACH_DAILY_CAP=
OUTREACH_MIN_GAP_HOURS=
# Sending window, local "start-end" hours (default 8-18) in OUTREACH_TIMEZONE (default America/Detroit), weekdays unless OUTREACH_WEEKENDS=true
OUTREACH_SEND_HOURS=
OUTREACH_TIMEZONE=
OUTREACH_WEEKENDS=
# --- Daily brief (ADR-046): worker-lifecycle ---
# Emailed from the outreach mailbox to this address after BRIEF_HOUR (default 7) local time
# (BRIEF_TIMEZONE, default OUTREACH_TIMEZONE). Unset: the brief is only in the app (/brief).
BRIEF_EMAIL_TO=
BRIEF_HOUR=
BRIEF_TIMEZONE=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
EMAIL_FROM=
SMTP_URL=
# --- Security ---
APPROVAL_TOKEN_SECRET=change-me
AUDIT_ANCHOR_ENABLED=false
# --- Decision packet defaults (ADR-016) ---
APPROVAL_TIMEOUT_MINUTES=60
MISSION_REFRESH_INTERVAL_MINUTES=15
SUPPLY_STALE_MINUTES=1440
# --- Connectors (§17) ---
# eBay Browse API (both required; absent = not used)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Marketplace Account Deletion endpoint (GET/POST /v1/webhooks/ebay/account-deletion).
# 32-80 chars of A-Z a-z 0-9 _ -; enter the same value in the eBay developer portal.
# Also needs PUBLIC_API_BASE_URL (the URL eBay calls is part of the challenge hash).
EBAY_VERIFICATION_TOKEN=
# Reverb public API: keyless once enabled; token optional (higher rate limits)
REVERB_ENABLED=false
REVERB_API_TOKEN=
# --- Opportunity intelligence (AIOOS) ---
# Needs a search key and a model; hard daily cap on search + LLM spend (USD, per UTC day)
# Search provider: brave (default) or serper (about $1 per 1,000 queries vs Brave's $5)
# INTEL_SEARCH_PROVIDER=serper   (brave | serper | youcom; youcom uses YDC_API_KEY)
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=
# Per-query price the budget charges, if your plan's rate differs from the provider default
# INTEL_SEARCH_COST_PER_QUERY_USD=
# Per-call estimates checked before each model call (defaults 0.006 / 0.04); lower them for cheaper models
# INTEL_DETECTION_ESTIMATE_USD=
# INTEL_ASSESSMENT_ESTIMATE_USD=
INTEL_DAILY_BUDGET_USD=1
INTEL_QUERIES_PER_RUN=8
# Match the worker-intel cron (every 6h = 4); the daily cap is paced across these runs
INTEL_RUNS_PER_DAY=4
INTEL_MAX_ASSESSMENTS=3
# Targeted searches for the other side per run, and watchlist hypotheses revisited per run
# INTEL_COUNTERPART_SEARCHES=4
# INTEL_HYPOTHESIS_CHECKS=2
# Per-deal capital exposure before a deal is held at WATCH; unset = no cap
# DEAL_MAX_CAPITAL_USD=1000
# Lets an external agent POST new search sources to /v1/intel/sources (header x-intel-sources-token)
INTEL_SOURCES_TOKEN=
# Built-in fake fixture listings; default on outside production, off in production
# FIXTURE_CONNECTORS=
# Fallback search term when no active mission supplies one
CONNECTOR_SEED_QUERY=
# Inbound messages accepted per sender per hour on Telegram/SMS/email/WhatsApp webhooks (default 20)
# INBOUND_MESSAGES_PER_HOUR=
