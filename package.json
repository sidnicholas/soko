{
  "name": "opportunity-os",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "dev": "turbo run dev",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:migrate": "tsx packages/db/src/migrate.ts",
    "db:pgvector": "tsx packages/db/src/pgvector.ts"
  },
  "devDependencies": {
    "@temporalio/testing": "1.23.0",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "turbo": "^2.2.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.7",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.7",
    "@nestjs/platform-fastify": "^10.4.7",
    "@nestjs/swagger": "^8.0.5",
    "@supabase/supabase-js": "^2.46.1",
    "@temporalio/activity": "^1.11.5",
    "@temporalio/client": "^1.11.5",
    "@temporalio/worker": "^1.11.5",
    "@temporalio/workflow": "^1.11.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "kysely": "^0.27.4",
    "next": "^14.2.18",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^17.3.1",
    "zod": "^3.23.8"
  }
}
