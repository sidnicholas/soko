{
  "extends": "./tsconfig.base.json",
  "compilerOptions": { "noEmit": true },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "apps/*/src/**/*.ts",
    "apps/*/src/**/*.tsx",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules", "**/dist", "**/.next", "apps/web/**"]
}
